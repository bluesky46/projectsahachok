        <bpmndi:BPMNLabel>
          <dc:Bounds x="4300" y="172" width="120" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_check_di" bpmnElement="t_check">
        <dc:Bounds x="670" y="263" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_stock_di" bpmnElement="gw_stock" isMarkerVisible="true">
        <dc:Bounds x="975" y="283" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="955" y="259" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_offer_di" bpmnElement="t_offer">
        <dc:Bounds x="1150" y="263" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_record_di" bpmnElement="t_record">
        <dc:Bounds x="1150" y="398" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_pricetype_di" bpmnElement="t_pricetype">
        <dc:Bounds x="1390" y="263" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_quote_di" bpmnElement="t_quote">
        <dc:Bounds x="1630" y="263" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_receipt_di" bpmnElement="t_receipt">
        <dc:Bounds x="2110" y="263" width="180" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ship_di" bpmnElement="gw_ship" isMarkerVisible="true">
        <dc:Bounds x="2415" y="283" width="50" height="50" />
