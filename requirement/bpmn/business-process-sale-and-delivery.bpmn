<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Process_Business" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:collaboration id="Process_Business_collab">
    <bpmn:participant id="Process_Business_pool" name="ร้านขายหลังคาเหล็ก — กระบวนการขายและส่งมอบสินค้า" processRef="Process_Business" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Business" name="กระบวนการธุรกิจ: ขายและส่งมอบสินค้า — ร้านขายหลังคาเหล็ก" isExecutable="false">
    <bpmn:laneSet id="Process_Business_lanes">
      <bpmn:lane id="Process_Business_lane0" name="ลูกค้า">
        <bpmn:flowNodeRef>start_cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nosale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_Business_lane1" name="พนักงานขาย">
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pricetype</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_Business_lane2" name="เจ้าของร้าน / ผู้จัดการ">
        <bpmn:flowNodeRef>t_assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_proof</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Process_Business_lane3" name="พนักงานส่งของ">
        <bpmn:flowNodeRef>t_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_proof</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reproof</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_cust" name="ลูกค้าต้องการซื้อสินค้า">
      <bpmn:outgoing>Process_Business_flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_request" name="แจ้งรายการสินค้าที่ต้องการ">
      <bpmn:incoming>Process_Business_flow1</bpmn:incoming>
      <bpmn:incoming>Process_Business_flow7</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_alt" name="รับข้อเสนอทางเลือกไหม?">
      <bpmn:incoming>Process_Business_flow5</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow6</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_nosale" name="ไม่เกิดการซื้อขาย">
      <bpmn:incoming>Process_Business_flow6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_pay" name="ชำระเงิน">
      <bpmn:incoming>Process_Business_flow11</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_receive" name="รับสินค้าที่ร้าน">
      <bpmn:incoming>Process_Business_flow14</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_sign" name="รับสินค้า + เซ็นรับ">
      <bpmn:incoming>Process_Business_flow25</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e_closed" name="ปิดการขาย">
      <bpmn:incoming>Process_Business_flow15</bpmn:incoming>
      <bpmn:incoming>Process_Business_flow33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e_cancel" name="ยกเลิกรายการขาย">
      <bpmn:incoming>Process_Business_flow24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t_check" name="ตรวจสอบสินค้า&#10;และจำนวนคงเหลือ">
      <bpmn:incoming>Process_Business_flow2</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_stock" name="มีสินค้าพอขายไหม?">
      <bpmn:incoming>Process_Business_flow3</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow4</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_offer" name="เสนอทางเลือก&#10;(สั่งเพิ่ม / สินค้าทดแทน)">
      <bpmn:incoming>Process_Business_flow4</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_record" name="บันทึกรายการขาย">
      <bpmn:incoming>Process_Business_flow8</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_pricetype" name="ระบุประเภทลูกค้า&#10;(ทั่วไป / ร้านค้า / ช่าง)&#10;เพื่อคิดราคาปลีกหรือราคาส่ง">
      <bpmn:incoming>Process_Business_flow9</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_quote" name="แจ้งยอดรวมที่ต้องชำระ&#10;(รวมภาษีมูลค่าเพิ่ม)">
      <bpmn:incoming>Process_Business_flow10</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_receipt" name="ออกใบเสร็จ">
      <bpmn:incoming>Process_Business_flow12</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_ship" name="ลูกค้ารับเองหรือให้จัดส่ง?">
      <bpmn:incoming>Process_Business_flow13</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow14</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_refund" name="คืนเงินลูกค้า&#10;และรับสินค้ากลับเข้าร้าน">
      <bpmn:incoming>Process_Business_flow23</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_assign" name="มอบหมายงานจัดส่ง&#10;ให้พนักงานส่งของ">
      <bpmn:incoming>Process_Business_flow16</bpmn:incoming>
      <bpmn:incoming>Process_Business_flow22</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_retry" name="นัดส่งใหม่ไหม?">
      <bpmn:incoming>Process_Business_flow21</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow22</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_verify" name="ตรวจหลักฐานการส่ง">
      <bpmn:incoming>Process_Business_flow27</bpmn:incoming>
      <bpmn:incoming>Process_Business_flow31</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_proof" name="หลักฐานครบถ้วนไหม?">
      <bpmn:incoming>Process_Business_flow28</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow29</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_reject" name="แจ้งให้ส่งหลักฐานเพิ่ม">
      <bpmn:incoming>Process_Business_flow29</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_close" name="ปิดงานจัดส่ง">
      <bpmn:incoming>Process_Business_flow32</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_accept" name="รับงานจัดส่ง">
      <bpmn:incoming>Process_Business_flow17</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t_deliver" name="นำสินค้าไปส่งลูกค้า">
      <bpmn:incoming>Process_Business_flow18</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="gw_delivered" name="ส่งสำเร็จไหม?">
      <bpmn:incoming>Process_Business_flow19</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow20</bpmn:outgoing>
      <bpmn:outgoing>Process_Business_flow25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t_fail" name="แจ้งเหตุผลที่ส่งไม่สำเร็จ">
      <bpmn:incoming>Process_Business_flow20</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_proof" name="บันทึกหลักฐานการส่ง&#10;(รูปถ่าย / ลายเซ็นลูกค้า)">
      <bpmn:incoming>Process_Business_flow26</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t_reproof" name="ส่งหลักฐานเพิ่มเติม">
      <bpmn:incoming>Process_Business_flow30</bpmn:incoming>
      <bpmn:outgoing>Process_Business_flow31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Process_Business_flow1" sourceRef="start_cust" targetRef="t_request" />
    <bpmn:sequenceFlow id="Process_Business_flow2" sourceRef="t_request" targetRef="t_check" />
    <bpmn:sequenceFlow id="Process_Business_flow3" sourceRef="t_check" targetRef="gw_stock" />
    <bpmn:sequenceFlow id="Process_Business_flow4" name="ไม่พอ" sourceRef="gw_stock" targetRef="t_offer" />
    <bpmn:sequenceFlow id="Process_Business_flow5" sourceRef="t_offer" targetRef="gw_alt" />
    <bpmn:sequenceFlow id="Process_Business_flow6" name="ไม่รับ" sourceRef="gw_alt" targetRef="e_nosale" />
    <bpmn:sequenceFlow id="Process_Business_flow7" name="รับข้อเสนอ" sourceRef="gw_alt" targetRef="t_request" />
    <bpmn:sequenceFlow id="Process_Business_flow8" name="พอขาย" sourceRef="gw_stock" targetRef="t_record" />
    <bpmn:sequenceFlow id="Process_Business_flow9" sourceRef="t_record" targetRef="t_pricetype" />
    <bpmn:sequenceFlow id="Process_Business_flow10" sourceRef="t_pricetype" targetRef="t_quote" />
    <bpmn:sequenceFlow id="Process_Business_flow11" sourceRef="t_quote" targetRef="t_pay" />
    <bpmn:sequenceFlow id="Process_Business_flow12" sourceRef="t_pay" targetRef="t_receipt" />
    <bpmn:sequenceFlow id="Process_Business_flow13" sourceRef="t_receipt" targetRef="gw_ship" />
    <bpmn:sequenceFlow id="Process_Business_flow14" name="รับเองที่ร้าน" sourceRef="gw_ship" targetRef="t_receive" />
    <bpmn:sequenceFlow id="Process_Business_flow15" sourceRef="t_receive" targetRef="e_closed" />
    <bpmn:sequenceFlow id="Process_Business_flow16" name="ให้จัดส่ง" sourceRef="gw_ship" targetRef="t_assign" />
    <bpmn:sequenceFlow id="Process_Business_flow17" sourceRef="t_assign" targetRef="t_accept" />
    <bpmn:sequenceFlow id="Process_Business_flow18" sourceRef="t_accept" targetRef="t_deliver" />
    <bpmn:sequenceFlow id="Process_Business_flow19" sourceRef="t_deliver" targetRef="gw_delivered" />
    <bpmn:sequenceFlow id="Process_Business_flow20" name="ไม่สำเร็จ" sourceRef="gw_delivered" targetRef="t_fail" />
    <bpmn:sequenceFlow id="Process_Business_flow21" sourceRef="t_fail" targetRef="gw_retry" />
    <bpmn:sequenceFlow id="Process_Business_flow22" name="นัดส่งใหม่" sourceRef="gw_retry" targetRef="t_assign" />
    <bpmn:sequenceFlow id="Process_Business_flow23" name="ยกเลิก" sourceRef="gw_retry" targetRef="t_refund" />
    <bpmn:sequenceFlow id="Process_Business_flow24" sourceRef="t_refund" targetRef="e_cancel" />
    <bpmn:sequenceFlow id="Process_Business_flow25" name="สำเร็จ" sourceRef="gw_delivered" targetRef="t_sign" />
    <bpmn:sequenceFlow id="Process_Business_flow26" sourceRef="t_sign" targetRef="t_proof" />
    <bpmn:sequenceFlow id="Process_Business_flow27" sourceRef="t_proof" targetRef="t_verify" />
    <bpmn:sequenceFlow id="Process_Business_flow28" sourceRef="t_verify" targetRef="gw_proof" />
    <bpmn:sequenceFlow id="Process_Business_flow29" name="ไม่ครบ" sourceRef="gw_proof" targetRef="t_reject" />
    <bpmn:sequenceFlow id="Process_Business_flow30" sourceRef="t_reject" targetRef="t_reproof" />
    <bpmn:sequenceFlow id="Process_Business_flow31" name="ส่งใหม่" sourceRef="t_reproof" targetRef="t_verify" />
    <bpmn:sequenceFlow id="Process_Business_flow32" name="ครบถ้วน" sourceRef="gw_proof" targetRef="t_close" />
    <bpmn:sequenceFlow id="Process_Business_flow33" sourceRef="t_close" targetRef="e_closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Process_Business_diagram">
    <bpmndi:BPMNPlane id="Process_Business_plane" bpmnElement="Process_Business_collab">
      <bpmndi:BPMNShape id="Process_Business_pool_di" bpmnElement="Process_Business_pool" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="4820" height="910" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Process_Business_lane3_di" bpmnElement="Process_Business_lane3" isHorizontal="true" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="190" y="830" width="4790" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Process_Business_lane2_di" bpmnElement="Process_Business_lane2" isHorizontal="true" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="190" y="535" width="4790" height="295" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Process_Business_lane1_di" bpmnElement="Process_Business_lane1" isHorizontal="true" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="190" y="240" width="4790" height="295" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Process_Business_lane0_di" bpmnElement="Process_Business_lane0" isHorizontal="true" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="190" y="80" width="4790" height="160" />
      </bpmndi:BPMNShape>
