%% หน้าที่และสิทธิ์ของแต่ละบทบาท (Roles & Responsibility)
%% render: npx -y @mermaid-js/mermaid-cli -i 03-roles-responsibility.mmd -o 03-roles-responsibility.svg

graph LR
    subgraph roles["บทบาทในร้าน"]
        seller["พนักงานขาย"]
        owner["เจ้าของร้าน / ผู้จัดการ"]
        rider["พนักงานส่งของ"]
    end

    seller --> r1["ขายหน้าร้าน + ออกใบเสร็จ"]
    seller --> r2["ดูสินค้าและจำนวนคงเหลือ"]
    seller --> r3["บันทึกข้อมูลลูกค้า"]

    owner --> r1
    owner --> r4["ตั้งราคา / เงื่อนไขราคาส่ง"]
    owner --> r5["รับสินค้าเข้าร้าน + แก้ไขจำนวนคงเหลือ"]
    owner --> r6["มอบหมายงานจัดส่ง + ตรวจหลักฐาน"]
    owner --> r7["อนุมัติยกเลิก / คืนเงิน"]
    owner --> r8["ดูรายงานยอดขาย"]
    owner --> r9["เพิ่ม-ลบผู้ใช้และกำหนดบทบาท"]

    rider --> r10["เห็นเฉพาะงานส่งของตัวเอง"]
    rider --> r11["บันทึกหลักฐานการส่ง"]
